# Base de datos (SQLite para desarrollo local rápido, o PostgreSQL/Supabase en producción)
DATABASE_URL="file:./dev.db"

# Servidor API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Nivel del logger estructurado (NDJSON): debug | info | warn | error | silent
LOG_LEVEL=debug
# Límite de tamaño del body entrante en bytes
BODY_LIMIT_BYTES=1048576
# Máximo de peticiones por minuto y por IP
RATE_LIMIT_MAX=300
# Token para GET /metrics (header x-metrics-token). Sin él, en producción responde 404.
METRICS_TOKEN=

# Seguridad de la API (obligatorio en producción; usa >= 32 caracteres aleatorios)
JWT_SECRET=
CORS_ORIGINS=http://localhost:3001
# Host público de la API (sin protocolo), p. ej. api.clinica.mx. Obligatorio en
# producción: el TwiML de Twilio lo usa como destino del media stream, y tomarlo
# del header Host dejaría que quien llama redirija el audio.
PUBLIC_API_HOST=
# Correos autorizados para crear clínicas nuevas (separados por coma)
PLATFORM_ADMIN_EMAILS=

# Inteligencia Artificial (Google Gemini 2.5 Flash)
GEMINI_API_KEY=

# Meta Cloud API (WhatsApp Business, Instagram Direct, Messenger)
META_VERIFY_TOKEN=asistente_mexico_secret_2026
META_APP_SECRET=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Telefonía Twilio México (+52)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+525555123456
# Transferencia de una llamada viva a recepción humana (Twilio Calls redirect)
TWILIO_HUMAN_NUMBER=
TWILIO_HUMAN_DIAL_TIMEOUT=30

# --- Pipeline de voz en tiempo real (Twilio Media Streams) ---
# Deepgram Nova-2 (STT en tiempo real para llamadas)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=es
DEEPGRAM_ENDPOINTING_MS=300

# Cartesia Sonic (TTS de ultra baja latencia; salida mu-law 8 kHz para Twilio)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
CARTESIA_LANGUAGE=es

# Comportamiento del pipeline de voz.
# auto = sólo se activa si DEEPGRAM_API_KEY y CARTESIA_API_KEY están definidas.
VOICE_PIPELINE_ENABLED=auto
VOICE_LANGUAGE=es
VOICE_BARGE_IN=true
VOICE_BARGE_IN_FRAMES=5
VOICE_SPEECH_RMS_THRESHOLD=0.02
VOICE_SILENCE_MS=700
VOICE_MIN_SPEECH_MS=250
VOICE_MAX_UTTERANCE_MS=15000
VOICE_MAX_TURNS=30
VOICE_MAX_CALL_MS=900000
VOICE_PACE_AUDIO=true
VOICE_HANGUP_ON_HANDOVER=true

# Token compartido: el TwiML lo envía como <Parameter name="authToken"> y el
# WebSocket lo valida antes de abrir el pipeline. Vacío = no se exige.
VOICE_STREAM_TOKEN=

# Pasarela de Pagos (Mercado Pago México / Stripe MXN)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Ventana de frescura de la firma del webhook (ms). Fuera de ella la
# notificación se rechaza, para que una capturada no se pueda reenviar.
MERCADOPAGO_SIGNATURE_TOLERANCE_MS=300000
MERCADOPAGO_API_BASE=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_URL=
STRIPE_SECRET_KEY=

# Reintentos de envío de WhatsApp
WHATSAPP_SEND_ATTEMPTS=3
WHATSAPP_RETRY_DELAY_MS=300

# --- Cola durable de webhooks y outbox (tabla Job) ---------------------------
# Los webhooks de Meta/Twilio/Mercado Pago encolan y responden 200 de inmediato.
# Pon QUEUE_WORKER_ENABLED=false en las instancias que solo sirven HTTP si
# quieres correr el worker como proceso aparte.
QUEUE_WORKER_ENABLED=true
JOBS_POLL_INTERVAL_MS=1000
JOBS_BATCH_SIZE=5
JOBS_MAX_ATTEMPTS=5
JOBS_BASE_BACKOFF_MS=2000
JOBS_MAX_BACKOFF_MS=300000

# Bootstrap del administrador del dashboard (seed / admin:create)
SEED_ADMIN_EMAIL=admin@sonrisaspolanco.mx
SEED_ADMIN_PASSWORD=
