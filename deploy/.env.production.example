# Variables para `docker compose --env-file deploy/.env.production up -d --build`.
# Copia este archivo a deploy/.env.production (o a .env.production en la raíz)
# y rellena los valores reales. NUNCA lo subas a git (ya está en .gitignore).

# --- Dirección pública -------------------------------------------------------
# Solo aplica en la Opción A (VPS dedicado, Caddy propio incluido —
# --profile standalone). Sin dominio todavía: deja ":80" y entra por la IP
# del VPS. Con dominio apuntando aquí: pon el dominio y Caddy saca el HTTPS
# solo (Let's Encrypt), sin tocar nada más — ni el Caddyfile ni docker-compose.yml.
SITE_ADDRESS=:80

# Solo aplica en la Opción B (VPS compartido, deploy/docker-compose.proxy-externo.yml):
# nombre de la red Docker externa de tu reverse proxy existente (`docker
# network ls`). Ver deploy/README.md.
PROXY_NETWORK_NAME=proxy

# La cookie de sesión es "Secure" por defecto en producción. Sobre HTTP plano
# (Opción A sin dominio todavía) un navegador real la descarta en silencio y
# el login parece fallar sin ningún error visible — por eso, en ese caso
# concreto, déjalo en "false". En la Opción B ya hay HTTPS real vía tu proxy
# existente, así que puedes dejarlo sin definir (usa "true", el default en
# producción). Vuelve a "true" (o bórralo) en la Opción A en cuanto tengas
# dominio + HTTPS.
COOKIE_SECURE=false

# --- Base de datos (contenedor Postgres de este mismo compose) --------------
POSTGRES_USER=asistente
POSTGRES_PASSWORD=
POSTGRES_DB=asistente

# --- Seguridad de la API (obligatorias) --------------------------------------
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Producción (recomendadas; env.ts avisa si faltan) -----------------------
# Dominio o IP pública SIN protocolo, ej. clinica.mx o 51.83.x.x. Twilio Media
# Streams lo usa como destino del WebSocket de voz.
PUBLIC_API_HOST=
# Origen exacto donde vive el panel, ej. https://clinica.mx (sin slash final).
CORS_ORIGINS=
# Correos autorizados para dar de alta clínicas nuevas, separados por coma.
PLATFORM_ADMIN_EMAILS=

# --- Bootstrap del primer administrador --------------------------------------
SEED_ADMIN_EMAIL=admin@tuclinica.mx
SEED_ADMIN_PASSWORD=

# --- Secretos de validación de webhooks (obligatorios en producción) --------
# env.ts rechaza el arranque en producción si faltan, aunque todavía no
# conectes la integración real: son los secretos que validan la firma de
# webhooks entrantes (HMAC), y arrancar sin ellos dejaría esos endpoints
# aceptando peticiones sin verificar. Si aún no tienes el valor real de Meta/
# Twilio/Mercado Pago, pon un valor aleatorio de relleno (openssl rand -hex 32)
# y reemplázalo cuando conectes esa integración — mientras tanto no llega
# tráfico real a esos webhooks, así que el valor de relleno no importa.
META_APP_SECRET=
TWILIO_AUTH_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Integraciones externas (dejar vacío = modo simulación, como en dev) ----
# Estas sí pueden quedar vacías: solo activan la integración real cuando las
# rellenas, sin bloquear el arranque en producción. Todo este archivo llega
# a la API por `env_file`, así que cualquier variable documentada en
# .env.example se puede agregar aquí sin tocar docker-compose.yml.

# LLM del agente (sin esta llave la IA responde con el motor heurístico).
DEEPSEEK_API_KEY=

META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Telefonía: Twilio o SignalWire. Si las tres de SignalWire están presentes,
# tienen prioridad para la transferencia a recepción humana.
TWILIO_ACCOUNT_SID=
TWILIO_HUMAN_NUMBER=
SIGNALWIRE_SIGNING_KEY=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=
# OBLIGATORIO (mín. 32 caracteres): openssl rand -hex 32
# Secreto compartido entre el TwiML y el WebSocket de voz. Sin él, cualquiera
# que conozca la URL del stream podría abrir una sesión de voz haciéndose pasar
# por el número de un paciente; env.ts rechaza el arranque si falta.
VOICE_STREAM_TOKEN=

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Anticipos de pacientes: cada clínica conecta SU cuenta en Ajustes y el
# dinero cae ahí. En producción este token global ya no se usa para anticipos
# (déjalo vacío); los avisos de pago llegan a
# https://<PUBLIC_API_HOST>/webhooks/mercadopago/clinica/<id-de-la-clínica>.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=
# Mensualidades de las clínicas (a favor de la plataforma). Cuenta distinta
# a la de arriba; sin ella nadie puede contratar un plan.
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=
# URL pública del panel: a donde regresa Mercado Pago tras autorizar, y base
# de los enlaces de recuperación de contraseña.
APP_PUBLIC_URL=

# Correo transaccional vía Resend. Sin la llave, nadie puede recuperar su
# contraseña en producción (el correo se descarta, no se imprime en el log).
# EMAIL_FROM debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Plantilla aprobada por Meta para recordatorios. Meta solo acepta texto libre
# a quien escribió en las últimas 24 h; a los demás, solo plantillas. Sin esta
# variable, los recordatorios fuera de esa ventana no se envían (no se intentan:
# fallarían). La plantilla debe existir con este nombre en la cuenta de WhatsApp
# Business de cada número que envía, con 4 variables en el cuerpo — {{1}}
# paciente, {{2}} clínica, {{3}} fecha y hora, {{4}} especialista — y dos
# botones de respuesta rápida: confirmar y reagendar, en ese orden.
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANG=es_MX
