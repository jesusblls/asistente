{
  "name": "asistente-omnicanal-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma SaaS Multi-Tenant de Asistente IA Omnicanal (Voz Twilio +52, WhatsApp, Instagram, Messenger)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/observability && npm run build --workspace=packages/shared-types && npm run build --workspace=packages/database && npm run build --workspace=packages/ai-agent && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:migrate:status": "npm run migrate:status --workspace=packages/database",
    "setup": "bash scripts/setup.sh",
    "dev": "npm run dev --workspace=apps/api",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "test": "npm run test --workspaces --if-present",
    "test:security": "npm run test --workspace=@asistente/api",
    "test:stress": "npm run test:stress --workspace=@asistente/ai-agent",
    "test:e2e": "npm run test:e2e --workspace=@asistente/web",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:push": "npm run push --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "admin:create": "npm run admin:create --workspace=packages/database"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
