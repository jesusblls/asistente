generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  phoneE164             String            // Ej: "+525512345678"
  timezone              String            @default("America/Mexico_City")
  address               String?
  emergencyInstructions String?
  welcomeMessage        String?
  isActive              Boolean           @default(true)

  /// Plan contratado: trial | consultorio | clinica-pro | cadenas.
  /// El catálogo de cupos vive en `@asistente/shared-types` (PLANS) para que
  /// el precio anunciado y el límite aplicado no puedan separarse.
  planSlug              String            @default("trial")
  /// TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED
  subscriptionStatus    String            @default("TRIALING")
  /// Fin de la prueba gratuita. Null en cuentas que nunca estuvieron en prueba.
  trialEndsAt           DateTime?

  /// MONTHLY | ANNUAL. Null mientras la clínica no ha contratado.
  billingCycle          String?
  /// Id de la suscripción (preapproval) en Mercado Pago. Único: dos clínicas
  /// no pueden compartir la misma autorización de cobro.
  mpPreapprovalId       String?           @unique
  /// Hasta cuándo está pagado el servicio. Lo extiende cada cobro autorizado.
  currentPeriodEnd      DateTime?
  /// Último cobro procesado, para que un reenvío del webhook de Mercado Pago
  /// no extienda el periodo dos veces.
  lastPaymentId         String?

  /// Paso del asistente de configuración inicial; null cuando ya terminó.
  /// Sin esto la IA atendería pacientes con horarios y precios inventados.
  onboardingStep        String?
  onboardingCompletedAt DateTime?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  users                 User[]
  doctors               Doctor[]
  services              Service[]
  patients              Patient[]
  appointments          Appointment[]
  conversations         Conversation[]
  channelConfigs        ChannelConfig[]
  faqItems              FaqItem[]
  usageCounters         UsageCounter[]
}

/// Consumo acumulado por clínica y periodo, para aplicar los cupos del plan.
///
/// Solo se persiste aquí lo que no tiene otra fuente de verdad: los segundos
/// de telefonía, que se pierden cuando la llamada cuelga. Las citas del mes
/// se cuentan directo en `Appointment` — duplicarlas aquí abriría la puerta a
/// que el contador y la realidad se separen tras un borrado o un reagendado.
model UsageCounter {
  id        String   @id @default(cuid())
  tenantId  String
  /// VOICE_SECONDS
  metric    String
  /// Mes natural en America/Mexico_City, formato "2026-09".
  period    String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, period])
  @@index([tenantId, period])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         String   @default("STAFF") // ADMIN, RECEPTIONIST, DOCTOR, STAFF
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Doctor {
  id                String        @id @default(cuid())
  tenantId          String
  name              String
  specialty         String
  phone             String?
  email             String?
  calendarId        String?
  availabilityRules String?       // JSON serializado con horarios de consulta y buffers
  isActive          Boolean       @default(true)

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments      Appointment[]

  @@index([tenantId, isActive])
}

model Service {
  id                 String        @id @default(cuid())
  tenantId           String
  name               String
  description        String?
  durationMinutes    Int           @default(30)
  priceMxn           Float         @default(0.0)
  requiredDepositMxn Float         @default(0.0)
  category           String?
  isActive           Boolean       @default(true)

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments       Appointment[]

  @@index([tenantId, isActive])
}

model Patient {
  id            String         @id @default(cuid())
  tenantId      String
  fullName      String
  phoneE164     String         // Normalizado E.164: +52...
  whatsappId    String?
  instagramId   String?
  messengerId   String?
  email         String?
  notes         String?
  isVip         Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  conversations Conversation[]

  @@unique([tenantId, phoneE164])
  @@index([tenantId, fullName])
}

model Appointment {
  id                 String   @id @default(cuid())
  tenantId           String
  patientId          String
  doctorId           String
  serviceId          String
  startTime          DateTime
  endTime            DateTime
  status             String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED, RESCHEDULED, COMPLETED, NO_SHOW
  paymentStatus      String   @default("NONE")      // NONE, DEPOSIT_PENDING, DEPOSIT_PAID, FULLY_PAID
  depositAmountMxn   Float?
  depositPaymentUrl  String?
  paymentReferenceId String?
  channelOrigin      String   @default("WHATSAPP")  // WHATSAPP, INSTAGRAM, MESSENGER, PHONE_CALL, WEBCHAT
  symptoms           String?
  notes              String?
  reminderSent24h    Boolean  @default(false)
  reminderSent2h     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Candado de doble reserva a nivel de base de datos: "<doctorId>|<startTime ISO>"
  /// mientras la cita ocupa el horario, y NULL cuando se cancela (los NULL no
  /// colisionan entre sí, así que el hueco queda libre para reagendar).
  /// La verificación de traslape en `SchedulerService` es la primera línea;
  /// esto atrapa las reservas simultáneas que pasan entre el SELECT y el INSERT.
  slotKey            String?  @unique

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service            Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, startTime])
  @@index([doctorId, startTime])
}

model Conversation {
  id                  String    @id @default(cuid())
  tenantId            String
  patientId           String
  channel             String    // WHATSAPP, INSTAGRAM, MESSENGER, PHONE_CALL, WEBCHAT
  externalChannelId   String    // ID del chat en WhatsApp/IG/Twilio Call SID
  isHandedOverToHuman Boolean   @default(false)
  lastMessageAt       DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@unique([tenantId, channel, externalChannelId])
  @@index([tenantId, lastMessageAt])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  tenantId          String
  direction         String       // INBOUND, OUTBOUND
  senderRole        String       // PATIENT, AI_AGENT, HUMAN_STAFF, SYSTEM
  content           String
  mediaUrl          String?
  channel           String       // WHATSAPP, INSTAGRAM, etc.
  externalMessageId String?      // wamid de Meta para idempotencia
  rawPayload        String?      // JSON
  deliveryStatus    String?      // PENDING, SENT, FAILED (solo salientes)
  createdAt         DateTime     @default(now())

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalMessageId])
  @@index([tenantId, createdAt])
  @@index([conversationId, createdAt])
}

model ChannelConfig {
  id            String   @id @default(cuid())
  tenantId      String
  channelType   String   // WHATSAPP, INSTAGRAM, MESSENGER, TWILIO
  credentials   String   // JSON con tokens/API keys; cifrado enc:v1: con CREDENTIALS_ENCRYPTION_KEY o claro en desarrollo
  webhookSecret String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channelType])
}

/// Cola de trabajos durable (outbox + webhooks en segundo plano).
///
/// Los webhooks de Meta/Twilio/Mercado Pago deben responder 200 en pocos
/// segundos: el trabajo pesado (agente Gemini, envío a WhatsApp) se persiste
/// aquí y lo procesa un worker con reintentos, backoff exponencial e
/// idempotencia vía `dedupeKey`.
model Job {
  id          String    @id @default(cuid())
  tenantId    String?
  type        String // META_INBOUND_MESSAGE | WHATSAPP_SEND | VOICE_POST_CALL_FOLLOWUP
  payload     String // JSON serializado
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED | DEAD
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  dedupeKey   String?   @unique
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([tenantId, type])
  @@index([status, updatedAt])
}

model FaqItem {
  id        String   @id @default(cuid())
  tenantId  String
  question  String
  answer    String
  category  String?  // Precios, Ubicación, Procedimientos, Cuidados
  keywords  String?  // Separados por comas para búsqueda semántica/léxica
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Bitácora de auditoría de accesos y cambios a datos clínicos (LFPDPPP,
/// NOM-024-SSA3): quién vio o modificó qué expediente, cuándo y desde dónde.
///
/// Solo inserción. Triggers de base de datos (migración 0003) rechazan todo
/// UPDATE y el DELETE de filas con menos de 5 años, plazo mínimo de
/// conservación del expediente clínico (NOM-004-SSA3-2012).
///
/// Sin relaciones a propósito: el rastro debe sobrevivir al borrado de la
/// clínica, del usuario que actuó o del paciente, y una FK con cascada lo
/// borraría junto con ellos. Se escribe con `recordAudit()`.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?  // null solo si no se pudo atribuir (login con correo inexistente)
  actorType  String   // USER | AI_AGENT | WEBHOOK | SYSTEM | ANONYMOUS
  actorId    String?
  actorEmail String?  // copia al momento del evento: el usuario puede cambiar o borrarse
  actorRole  String?
  action     String   // LOGIN | LOGIN_FAILED | READ | LIST | CREATE | UPDATE | DELETE | EXPORT
  entityType String   // SESSION | TENANT | DOCTOR | SERVICE | PATIENT | APPOINTMENT | CONVERSATION | MESSAGE | AUDIT_LOG
  entityId   String?
  patientId  String?
  changes    String?  // JSON { campo: { before, after } }
  metadata   String?  // JSON con contexto adicional (canal, filtros, conteos)
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId, createdAt])
}
